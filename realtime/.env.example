# Dabblebase Realtime Server Environment Variable Configuration
# This file is an example of the environment variables used by Dabblebase
# with default values to begin local development. Make sure to create a 
# `.env` file within the `/realtime` directory using these default values
# and customize as needed for your environment or for deployment purposes.

# Project mode ( development | production )
MODE=development

# Host information for the server
HOST=localhost:8000

# Variables to connect to the admin database
# NOTE: Do not edit any of the values below - these defaults have been set
# to match the database configuration of the local dev environment, which
# can be found in the `docker-compose.yml` file.
ADMIN_DB_USER=postgres
ADMIN_DB_PASSWORD=postgres
ADMIN_DB_HOST=db-admin-cluster
ADMIN_DB_PORT=5432
ADMIN_DB_DATABASE=dabblebase_admin

# Variables to connect to the content database
# NOTE: Do not edit any of the values below - these defaults have been set
# to match the database configuration of the local dev environment, which
# can be found in the `docker-compose.yml` file.
CONTENT_DB_USER=postgres
CONTENT_DB_PASSWORD=postgres
CONTENT_DB_HOST=db-content-cluster
CONTENT_DB_PORT=5432

# Secret used for signing authentication tokens for projects.
# NOTE: Replace this value with a randomly generated uuid, which can be
# generated here: https://www.uuidgenerator.net.
AUTH_MASTER_SECRET=REPLACE_ME