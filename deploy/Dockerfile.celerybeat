# Docker image for the Celery beat.

FROM python:3.12
RUN python3 -m pip install --upgrade pip
COPY ../server/requirements.txt /workspace/server/requirements.txt
RUN pip install --no-cache-dir --upgrade -r /workspace/server/requirements.txt
COPY ../server /workspace/server

# Create a writable directory for Celery beat schedule files
RUN mkdir -p /tmp/celery_data && chmod 755 /tmp/celery_data

WORKDIR /workspace
CMD ["celery", "-A", "server.celery.celery_app", "beat", "--loglevel=info", "--schedule=/tmp/celery_data/celerybeat-schedule"]
ENV TZ="America/New_York"